# Copy to .env and fill in. Leave a key blank if you use Ollama-only mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=            # optional: web search for factual verification
OLLAMA_BASE_URL=http://ollama:11434/v1
ARBITER_API_KEY=dev-key-change-me
ARBITER_DB_PATH=/data/arbiter.db
ARBITER_CONFIG=config.yaml
# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
